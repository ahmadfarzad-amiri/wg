print_menu_body() {
  local i n=0 role
  role="$(detect_role)"
  echo "  WG-OPS Management Script"
  echo "  Detected role: ${role}"
  echo "————————————————————————————————"
  for i in "${!MENU_ACTIONS[@]}"; do
    if [[ "${MENU_ACTIONS[$i]}" == "__section__" ]]; then
      echo "————————————————————————————————"
      echo "  ${MENU_LABELS[$i]}"
      continue
    fi
    echo "  ${n}. ${MENU_LABELS[$i]}"
    n=$((n + 1))
  done
  echo "————————————————————————————————"
}

show_menu() {
  clear 2>/dev/null || true
  local os_id
  os_id="$(os_release_id)"
  echo "The OS release is: ${os_id}"
  echo
  build_menu
  print_menu_body
  print_status_footer
  echo
}

# Print role-filtered menu to stdout (for docs/tests; no clear/status).
cmd_list_menu() {
  local role="${1:-}"
  if [[ -n "$role" ]]; then
    export WG_OPS_ROLE_OVERRIDE="$role"
  fi
  build_menu
  print_menu_body
  if [[ -n "$role" ]]; then
    unset WG_OPS_ROLE_OVERRIDE
  fi
}

menu_action_at() {
  local want="$1"
  local i n=0
  for i in "${!MENU_ACTIONS[@]}"; do
    if [[ "${MENU_ACTIONS[$i]}" == "__section__" ]]; then
      continue
    fi
    if [[ "$n" -eq "$want" ]]; then
      printf '%s' "${MENU_ACTIONS[$i]}"
      return 0
    fi
    n=$((n + 1))
  done
  return 1
}

menu_max_index() {
  local i n=-1
  for i in "${!MENU_ACTIONS[@]}"; do
    if [[ "${MENU_ACTIONS[$i]}" != "__section__" ]]; then
      n=$((n + 1))
    fi
  done
  printf '%s' "$n"
}

run_menu_action() {
  local action="$1"
  local role
  case "$action" in
    quit) echo "Bye."; exit 0 ;;
    install-exit)
      # Menu already pauses before redraw; skip installer key-copy pause.
      WG_OPS_MENU=1 run_install_exit
      ;;
    install-entry)
      WG_OPS_MENU=1 run_install_entry
      ;;
    update) cmd_update_all ;;
    pull) cmd_pull ;;
    update-panels) require_root; require_role entry; ensure_ops_ready; invoke_script update-panels.sh ;;
    uninstall) run_uninstall ;;
    uninstall-xray) run_uninstall_xray ;;
    test)
      require_root; ensure_ops_ready; require_role installed
      role="$(auto_script_role auto)"
      invoke_script test-connectivity.sh --role "$role"
      ;;
    diagnose)
      require_root; ensure_ops_ready; require_role installed
      role="$(auto_script_role auto)"
      invoke_script diagnose-vpn.sh --role "$role"
      ;;
    validate)
      require_root; ensure_ops_ready; require_role installed
      role="$(auto_script_role runtime)"
      # validate accepts entry|exit|runtime — map auto-detected entry/exit
      case "$(detect_role)" in
        entry) role=entry ;;
        exit) role=exit ;;
        both) role=runtime ;;
        *) role=runtime ;;
      esac
      invoke_script validate-config.sh --role "$role"
      ;;
    fix-routing)
      require_root; ensure_ops_ready; require_role installed
      role="$(auto_script_role auto)"
      invoke_script fix-vpn-routing.sh --role "$role"
      ;;
    tune)
      require_root; ensure_ops_ready; require_role installed
      role="$(auto_script_role auto)"
      invoke_script tune-vpn-performance.sh --role "$role"
      ;;
    measure)
      require_root; ensure_ops_ready
      role="$(auto_script_role guide)"
      invoke_script measure-vpn-bandwidth.sh --role "$role"
      ;;
    backup) require_root; ensure_ops_ready; require_role installed; invoke_script backup.sh ;;
    open-ports)
      require_root; ensure_ops_ready; require_role installed
      role="$(auto_script_role auto)"
      invoke_script open-firewall-ports.sh --role "$role"
      ;;
    fix-panels) require_root; require_role entry; ensure_ops_ready; invoke_script fix-panel-services.sh ;;
    styles) require_root; require_role entry; ensure_ops_ready; invoke_script check-sync-panel-styles.sh ;;
    change-entry) require_root; require_role entry; ensure_ops_ready; invoke_script change-entry-server.sh ;;
    change-exit) require_root; require_role entry; ensure_ops_ready; invoke_script change-exit-server.sh ;;
    add-peer) require_root; require_role exit; ensure_ops_ready; invoke_script add-entry-peer.sh ;;
    show-admin) require_root; show_admin_menu ;;
    set-admin-pass) require_root; set_admin_password_menu ;;
    install-xray) require_root; require_role entry; ensure_ops_ready; export WG_INSTALL_INTERACTIVE=1; invoke_script install-xray.sh ;;
    xray-client) require_root; require_role entry; ensure_ops_ready; invoke_script xray-client-add.sh ;;
    start) require_root; svc_start ;;
    stop) require_root; svc_stop ;;
    restart) require_root; svc_restart ;;
    status) print_status_footer ;;
    logs) require_root; svc_logs ;;
    enable) require_root; svc_enable ;;
    disable) require_root; svc_disable ;;
    *)
      echo "Invalid action: $action"
      ;;
  esac
}

handle_menu_choice() {
  local choice="$1"
  local action=""
  if ! [[ "$choice" =~ ^[0-9]+$ ]]; then
    echo "Invalid selection: $choice"
    return 1
  fi
  if ! action="$(menu_action_at "$choice")"; then
    echo "Invalid selection: $choice"
    return 1
  fi
  run_menu_action "$action"
}

menu_loop() {
  require_root
  ensure_ops_ready || true
  local choice="" max_idx
  while true; do
    show_menu
    max_idx="$(menu_max_index)"
    read -r -p "Please enter your selection [0-${max_idx}]: " choice || true
    choice="${choice// /}"
    [[ -n "$choice" ]] || continue
    echo
    set +e
    handle_menu_choice "$choice"
    set -e
    if [[ "$choice" == "0" ]]; then
      break
    fi
    # Always pause — tests/diagnose exit non-zero on failures; users still need to read output.
    pause_menu
  done
}

dispatch_cli() {
  local cmd="$1"
  shift || true
  case "$cmd" in
    -h|--help|help) cmd_help ;;
    menu) menu_loop ;;
    list-menu)
      cmd_list_menu "$@"
      ;;
    pull|get|sync) cmd_pull ;;
    install-cli) cmd_install_cli ;;
    self-update) cmd_pull; cmd_install_cli ;;
    update) cmd_update_all ;;
    list) cmd_list ;;
    path) printf '%s\n' "$OPS_DIR" ;;
    status) print_status_footer ;;
    start) require_root; svc_start ;;
    stop) require_root; svc_stop ;;
    restart) require_root; svc_restart ;;
    logs) require_root; svc_logs ;;
    show-admin) require_root; show_admin_menu ;;
    set-admin-pass) require_root; set_admin_password_menu ;;
    uninstall-xray) run_uninstall_xray ;;
    install-entry) run_install_entry ;;
    install-exit) run_install_exit ;;
    uninstall) run_uninstall ;;
    run)
      [[ $# -ge 1 ]] || die "Usage: $OPS_NAME run <script.sh> [args...]"
      local script="$1"
      shift
      run_script_exec "$script" "$@"
      ;;
    *)
      local mapped=""
      if mapped="$(script_for_command "$cmd")"; then
        ensure_ops_ready
        run_script_exec "$mapped" "$@"
      else
        die "Unknown command: $cmd (try: sudo $OPS_NAME   or   $OPS_NAME help)"
      fi
      ;;
  esac
}

main() {
  if [[ $# -eq 0 ]]; then
    menu_loop
    exit 0
  fi
  dispatch_cli "$@"
}

main "$@"
