handle_menu_choice() {
  local choice="$1"
  local role
  case "$choice" in
    0) echo "Bye."; exit 0 ;;
    1) run_install_exit ;;
    2) run_install_entry ;;
    3) cmd_update_all ;;
    4) cmd_pull ;;
    5) require_root; require_role entry; ensure_ops_ready; invoke_script update-panels.sh ;;
    6) run_uninstall ;;
    7) run_uninstall_xray ;;
    8)
      require_root; ensure_ops_ready
      role="$(ask_role auto)"
      invoke_script test-connectivity.sh --role "$role"
      ;;
    9)
      require_root; ensure_ops_ready
      role="$(ask_role auto)"
      invoke_script diagnose-vpn.sh --role "$role"
      ;;
    10)
      require_root; ensure_ops_ready
      role="$(ask_role runtime)"
      invoke_script validate-config.sh --role "$role"
      ;;
    11)
      require_root; ensure_ops_ready
      role="$(ask_role auto)"
      invoke_script fix-vpn-routing.sh --role "$role"
      ;;
    12)
      require_root; ensure_ops_ready
      role="$(ask_role auto)"
      invoke_script tune-vpn-performance.sh --role "$role"
      ;;
    13)
      require_root; ensure_ops_ready
      role="$(ask_role guide)"
      invoke_script measure-vpn-bandwidth.sh --role "$role"
      ;;
    14) require_root; ensure_ops_ready; invoke_script backup.sh ;;
    15)
      require_root; ensure_ops_ready
      role="$(ask_role auto)"
      invoke_script open-firewall-ports.sh --role "$role"
      ;;
    16) require_root; require_role entry; ensure_ops_ready; invoke_script fix-panel-services.sh ;;
    17) require_root; require_role entry; ensure_ops_ready; invoke_script check-sync-panel-styles.sh ;;
    18) require_root; svc_start ;;
    19) require_root; svc_stop ;;
    20) require_root; svc_restart ;;
    21) print_status_footer ;;
    22) require_root; svc_logs ;;
    23) require_root; svc_enable ;;
    24) require_root; svc_disable ;;
    25) require_root; require_role entry; ensure_ops_ready; invoke_script change-entry-server.sh ;;
    26) require_root; require_role entry; ensure_ops_ready; invoke_script change-exit-server.sh ;;
    27) require_root; require_role exit; ensure_ops_ready; invoke_script add-entry-peer.sh ;;
    28) require_root; show_admin_menu ;;
    29) require_root; set_admin_password_menu ;;
    30) require_root; require_role entry; ensure_ops_ready; export WG_INSTALL_INTERACTIVE=1; invoke_script install-xray.sh ;;
    31) require_root; require_role entry; ensure_ops_ready; invoke_script xray-client-add.sh ;;
    *)
      echo "Invalid selection: $choice"
      ;;
  esac
}

menu_loop() {
  require_root
  ensure_ops_ready || true
  local choice=""
  while true; do
    show_menu
    read -r -p "Please enter your selection [0-31]: " choice || true
    choice="${choice// /}"
    [[ -n "$choice" ]] || continue
    echo
    set +e
    handle_menu_choice "$choice"
    set -e
    if [[ "$choice" != "0" ]]; then
      pause_menu
    fi
  done
}

dispatch_cli() {
  local cmd="$1"
  shift || true
  case "$cmd" in
    -h|--help|help) cmd_help ;;
    menu) menu_loop ;;
    pull|get|sync) cmd_pull ;;
    install-cli) cmd_install_cli ;;
    self-update) cmd_pull; cmd_install_cli ;;
    update) cmd_update_all ;;
    list) cmd_list ;;
    path) printf '%s\n' "$OPS_DIR" ;;
    status) print_status_footer ;;
    start) require_root; svc_start ;;
    stop) require_root; svc_stop ;;
    restart) require_root; svc_restart ;;
    logs) require_root; svc_logs ;;
    show-admin) require_root; show_admin_menu ;;
    set-admin-pass) require_root; set_admin_password_menu ;;
    uninstall-xray) run_uninstall_xray ;;
    install-entry) run_install_entry ;;
    install-exit) run_install_exit ;;
    uninstall) run_uninstall ;;
    run)
      [[ $# -ge 1 ]] || die "Usage: $OPS_NAME run <script.sh> [args...]"
      local script="$1"
      shift
      run_script_exec "$script" "$@"
      ;;
    *)
      local mapped=""
      if mapped="$(script_for_command "$cmd")"; then
        ensure_ops_ready
        run_script_exec "$mapped" "$@"
      else
        die "Unknown command: $cmd (try: sudo $OPS_NAME   or   $OPS_NAME help)"
      fi
      ;;
  esac
}

main() {
  if [[ $# -eq 0 ]]; then
    menu_loop
    exit 0
  fi
  dispatch_cli "$@"
}

main "$@"
