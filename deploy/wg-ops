#!/usr/bin/env bash
# wg-ops — interactive operator menu + CLI for install / update / delete / ops.
# Does not replace WireGuard's native `wg` (e.g. `wg show`).
#
#   sudo wg-ops              # interactive menu
#   sudo wg-ops update       # pull scripts + update panels/tools
#   sudo wg-ops uninstall
#   sudo wg-ops test --role entry
set -euo pipefail

OPS_NAME="wg-ops"
OPS_DIR="${WG_OPS_DIR:-/opt/wg-ops}"
RAW_BASE="${WG_RAW_BASE:-${GITHUB_RAW_BASE:-https://cdn.jsdelivr.net/gh/ahmadfarzad-amiri/wg@v1.0.11}}"
BIN_PATH="${WG_OPS_BIN:-/usr/local/bin/wg-ops}"

log() { printf '[%s] %s\n' "$OPS_NAME" "$*"; }
warn() { printf '[%s] WARN: %s\n' "$OPS_NAME" "$*" >&2; }
die() { printf '[%s] ERROR: %s\n' "$OPS_NAME" "$*" >&2; exit 1; }

# Best-effort: report which semver jsDelivr resolved for this RAW_BASE (empty if not CDN).
cdn_resolved_version() {
  local hdr=""
  hdr="$(curl -fsSI "$RAW_BASE/deploy/wg-ops" 2>/dev/null | tr -d '\r' || true)"
  printf '%s\n' "$hdr" | awk -F': ' 'tolower($1)=="x-jsd-version"{print $2; exit}'
}

require_root() {
  [[ "$(id -u)" -eq 0 ]] || die "Run as root: sudo $OPS_NAME $*"
}

CORE_FILES=(
  repo.conf
  lib/common.sh
  wg-ops
  config.env.example
)

HELPER_SCRIPTS=(
  add-entry-peer.sh
  backup.sh
  change-entry-server.sh
  change-exit-server.sh
  check-sync-panel-styles.sh
  diagnose-vpn.sh
  fix-client-endpoint.sh
  fix-panel-services.sh
  fix-vpn-routing.sh
  install-entry-server.sh
  install-exit-server.sh
  install-xray.sh
  measure-vpn-bandwidth.sh
  open-firewall-ports.sh
  set-admin-password.py
  test-connectivity.sh
  tune-vpn-performance.sh
  uninstall-server.sh
  update-panels.sh
  validate-config.sh
  xray-client-add.sh
)

os_release_id() {
  if [[ -f /etc/os-release ]]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    printf '%s' "${ID:-unknown}"
  else
    printf 'unknown'
  fi
}

# Returns: none | entry | exit | both
detect_role() {
  if [[ -n "${WG_OPS_ROLE_OVERRIDE:-}" ]]; then
    printf '%s' "$WG_OPS_ROLE_OVERRIDE"
    return 0
  fi
  local has_entry=0 has_exit=0
  [[ -f /etc/wireguard/entry-server.env ]] && has_entry=1
  [[ -f /etc/wireguard/exit-server.env ]] && has_exit=1
  if (( has_entry && has_exit )); then
    printf 'both'
  elif (( has_entry )); then
    printf 'entry'
  elif (( has_exit )); then
    printf 'exit'
  else
    printf 'none'
  fi
}

role_is_entry() {
  local role
  role="$(detect_role)"
  [[ "$role" == "entry" || "$role" == "both" ]]
}

role_is_exit() {
  local role
  role="$(detect_role)"
  [[ "$role" == "exit" || "$role" == "both" ]]
}

role_is_installed() {
  local role
  role="$(detect_role)"
  [[ "$role" != "none" ]]
}

require_role() {
  local want="$1"
  local role
  role="$(detect_role)"
  case "$want" in
    entry)
      role_is_entry || die "This action requires the entry server (detected: ${role})."
      ;;
    exit)
      role_is_exit || die "This action requires the exit server (detected: ${role})."
      ;;
    installed)
      role_is_installed || die "No install detected on this host (detected: ${role})."
      ;;
    none)
      [[ "$role" == "none" ]] || die "This action requires a clean server (detected: ${role})."
      ;;
    *)
      die "Internal error: unknown role requirement '${want}'"
      ;;
  esac
}

# Role flag for scripts that take --role entry|exit|auto|...
auto_script_role() {
  local fallback="${1:-auto}"
  local role
  role="$(detect_role)"
  case "$role" in
    entry|exit) printf '%s' "$role" ;;
    both) printf 'auto' ;;
    *) printf '%s' "$fallback" ;;
  esac
}

# wg-quick@wg-clients → wg-clients
wg_if_from_unit() {
  local unit="$1"
  case "$unit" in
    wg-quick@*) printf '%s' "${unit#wg-quick@}" ;;
    *) printf '' ;;
  esac
}

iface_is_up() {
  local ifname="$1"
  [[ -n "$ifname" ]] && ip link show "$ifname" >/dev/null 2>&1
}

unit_state() {
  local unit="$1"
  local ifname=""
  ifname="$(wg_if_from_unit "$unit")"
  if systemctl is-active --quiet "$unit" 2>/dev/null; then
    printf 'Running'
  elif [[ -n "$ifname" ]] && iface_is_up "$ifname"; then
    # Interface left up after a failed/stopped unit — systemd shows inactive.
    printf 'Orphan (iface up)'
  elif systemctl cat "$unit" >/dev/null 2>&1; then
    printf 'Stopped'
  else
    printf 'n/a'
  fi
}

# Start wg-quick@IF even when the interface already exists outside systemd.
start_wg_quick_unit() {
  local ifname="$1"
  local unit="wg-quick@${ifname}"
  local rc=0
  if systemctl is-active --quiet "$unit" 2>/dev/null; then
    return 0
  fi
  if iface_is_up "$ifname"; then
    log "Clearing orphan interface ${ifname} before start"
    wg-quick down "$ifname" 2>/dev/null || true
    ip link del "$ifname" 2>/dev/null || true
  fi
  systemctl reset-failed "$unit" 2>/dev/null || true
  if ! systemctl start "$unit"; then
    rc=$?
    # PostUp failures often leave the iface up while the unit is failed.
    if iface_is_up "$ifname"; then
      warn "${ifname}: unit failed but interface is up — tearing down orphan"
      wg-quick down "$ifname" 2>/dev/null || true
      ip link del "$ifname" 2>/dev/null || true
    fi
    warn "${ifname}: start failed — last journal lines:"
    journalctl -u "$unit" -n 20 --no-pager >&2 || true
    if [[ -f "/etc/wireguard/${ifname}.conf" ]]; then
      warn "${ifname} hooks:"
      grep -E '^(Address|PreUp|PostUp|PreDown|PostDown)[[:space:]]*=' "/etc/wireguard/${ifname}.conf" >&2 || true
    fi
    return "$rc"
  fi
  return 0
}

unit_enabled() {
  local unit="$1"
  if systemctl is-enabled --quiet "$unit" 2>/dev/null; then
    printf 'Yes'
  else
    printf 'No'
  fi
}

print_status_footer() {
  local role
  role="$(detect_role)"
  echo
  echo "Role detected: ${role}"
  case "$role" in
    entry|both)
      echo "wg-clients:     $(unit_state 'wg-quick@wg-clients')  (autostart: $(unit_enabled 'wg-quick@wg-clients'))"
      echo "wg-tunnel:      $(unit_state 'wg-quick@wg-tunnel')  (autostart: $(unit_enabled 'wg-quick@wg-tunnel'))"
      echo "wg-panel:       $(unit_state wg-panel)  (autostart: $(unit_enabled wg-panel))"
      echo "wg-admin-panel: $(unit_state wg-admin-panel)  (autostart: $(unit_enabled wg-admin-panel))"
      if systemctl cat xray.service >/dev/null 2>&1; then
        echo "xray:           $(unit_state xray)  (autostart: $(unit_enabled xray))"
      fi
      if [[ "$role" == "both" ]]; then
        echo "(also exit-server.env present — combined entry+exit host)"
      fi
      ;;
    exit)
      echo "wg-tunnel:      $(unit_state 'wg-quick@wg-tunnel')  (autostart: $(unit_enabled 'wg-quick@wg-tunnel'))"
      ;;
    *)
      echo "No install detected (clean server)."
      ;;
  esac
  echo "Scripts dir:    ${OPS_DIR}"
  [[ -x "$BIN_PATH" ]] && echo "CLI:            ${BIN_PATH}" || echo "CLI:            not installed"
}

pause_menu() {
  echo
  read -r -p "Press Enter to continue..." _
}

ask_role() {
  local default="${1:-auto}"
  local detected choice=""
  detected="$(detect_role)"
  if [[ "$default" == "auto" ]]; then
    case "$detected" in
      entry|exit) default="$detected" ;;
      both) default="auto" ;;
    esac
  fi
  read -r -p "Role [${default}]: " choice || true
  choice="${choice:-$default}"
  printf '%s' "$choice"
}

ask_yes() {
  local prompt="$1"
  local ans=""
  read -r -p "${prompt} [y/N]: " ans || true
  [[ "${ans,,}" == "y" || "${ans,,}" == "yes" ]]
}

resolve_local_dir() {
  local here
  if [[ "${BASH_SOURCE[0]+set}" == "set" && -f "${BASH_SOURCE[0]}" ]]; then
    here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [[ -f "$here/lib/common.sh" || -f "$here/test-connectivity.sh" || -f "$here/wg-ops" ]]; then
      printf '%s' "$here"
      return 0
    fi
  fi
  return 1
}

fetch_one() {
  local rel="$1"
  local dest="$OPS_DIR/$rel"
  local url="$RAW_BASE/deploy/$rel"
  mkdir -p "$(dirname "$dest")"
  curl -fsSL "$url" -o "$dest"
  if [[ "$rel" == *.sh || "$rel" == "wg-ops" || "$rel" == *.py ]]; then
    chmod 755 "$dest"
  else
    chmod 644 "$dest"
  fi
}

source_ops_common() {
  if [[ -f "$OPS_DIR/lib/common.sh" ]]; then
    # shellcheck source=/dev/null
    source "$OPS_DIR/lib/common.sh"
    return 0
  fi
  local local_dir=""
  if local_dir="$(resolve_local_dir)" && [[ -f "$local_dir/lib/common.sh" ]]; then
    # shellcheck source=/dev/null
    source "$local_dir/lib/common.sh"
    return 0
  fi
  return 1
}

cmd_pull() {
  require_root pull
  local rel ver=""
  ver="$(cdn_resolved_version || true)"
  if [[ -n "$ver" ]]; then
    log "Fetching scripts into $OPS_DIR (CDN → v${ver})"
  else
    log "Fetching scripts into $OPS_DIR (base: $RAW_BASE)"
  fi
  log "  $RAW_BASE"
  mkdir -p "$OPS_DIR/lib"
  for rel in "${CORE_FILES[@]}" "${HELPER_SCRIPTS[@]}"; do
    log "  $rel"
    fetch_one "$rel" || warn "Failed to fetch $rel"
  done
  if [[ -f "$OPS_DIR/wg-ops" ]]; then
    install -m 755 "$OPS_DIR/wg-ops" "$BIN_PATH"
    log "CLI updated: $BIN_PATH"
  fi
  log "Scripts ready in $OPS_DIR"
  if [[ -f "$OPS_DIR/config.env.example" ]]; then
    log "Example env: $OPS_DIR/config.env.example"
    log "  cp $OPS_DIR/config.env.example /tmp/wg-prod.env"
  fi
}

cmd_install_cli() {
  require_root install-cli
  local src=""
  if [[ -f "$OPS_DIR/wg-ops" ]]; then
    src="$OPS_DIR/wg-ops"
  elif src="$(resolve_local_dir)" && [[ -f "$src/wg-ops" ]]; then
    src="$src/wg-ops"
  elif [[ "${BASH_SOURCE[0]+set}" == "set" && -f "${BASH_SOURCE[0]}" ]]; then
    src="${BASH_SOURCE[0]}"
  else
    die "No wg-ops source found. Run: sudo $OPS_NAME pull"
  fi
  install -m 755 "$src" "$BIN_PATH"
  log "Installed $BIN_PATH"
}

ensure_ops_ready() {
  if [[ ! -f "$OPS_DIR/lib/common.sh" || ! -f "$OPS_DIR/test-connectivity.sh" ]]; then
    log "Ops scripts missing — pulling..."
    cmd_pull
  fi
}

cmd_update_all() {
  require_root update
  local role
  role="$(detect_role)"
  log "=== Update all (${role}) ==="
  cmd_pull
  case "$role" in
    entry|both)
      invoke_script update-panels.sh
      if ask_yes "Apply routing/performance repair now?"; then
        if [[ "$role" == "both" ]]; then
          invoke_script tune-vpn-performance.sh --role entry
          invoke_script tune-vpn-performance.sh --role exit
        else
          invoke_script tune-vpn-performance.sh --role entry
        fi
      fi
      ;;
    exit)
      if ask_yes "Apply routing/performance repair now?"; then
        invoke_script tune-vpn-performance.sh --role exit
      fi
      log "Exit server: scripts updated. Panels live on the entry server."
      ;;
    *)
      log "No stack installed — scripts/CLI updated only."
      ;;
  esac
  log "Update complete."
}

cmd_list() {
  cat <<EOF
Ops dir: ${OPS_DIR}
CLI:     ${BIN_PATH}
Role:    $(detect_role)

CLI commands:
  menu, list-menu, pull, update, update-panels, install-entry, install-exit,
  uninstall, uninstall-xray, test, diagnose, tune, validate, fix-routing,
  measure, backup, open-ports, start, stop, restart, status, logs,
  change-entry, change-exit, add-peer, set-admin-pass, show-admin,
  install-xray, styles, fix-panels, run <script> [...]

Interactive menu filters options by detected role: none | entry | exit | both.
EOF
}

