# Example configuration — install-time and runtime env vars

# --- Install: exit server ---
WG_EXIT_PUBLIC_IP=203.0.113.50
WG_TUNNEL_PORT=51821
WG_CLIENT_CIDR=10.10.10.0/24
# WG_ENTRY_PUBLIC_IP=198.51.100.10   # restrict exit tunnel UDP to entry IP
# WG_ENTRY_TUNNEL_PUB=...            # optional: add entry peer during exit install
# WG_INSTALL_MODE=upgrade|fresh
# WG_INSTALL_FORCE=1                 # overwrite without upgrade mode
# WG_UFW_ENABLE=1
# WG_INSTALL_INTERACTIVE=1           # prompt on TTY

# --- Uninstall (removes all VPN + panel data from server) ---
# curl -fsSL .../uninstall-server.sh -o /tmp/uninstall-server.sh
# sudo WG_UNINSTALL_CONFIRM=yes bash /tmp/uninstall-server.sh
# WG_UNINSTALL_BACKUP=1              # backup /etc/wireguard before removal

# --- Install: entry server ---
WG_ENTRY_PUBLIC_IP=198.51.100.10     # public IP clients connect to (not private LAN IP)
WG_EXIT_PUBLIC_IP=203.0.113.50
WG_EXIT_TUNNEL_PORT=51821
WG_EXIT_TUNNEL_PUB=base64ExitTunnelPubKey=
WG_CLIENT_CIDR=10.10.10.0/24         # must match exit server
WG_CLIENT_PORT=51820
# WG_TUNNEL_LISTEN_PORT=51822       # entry wg-tunnel fixed UDP (return from exit)
# WG_UDP_PORT_RANGE=51820:51830     # ufw + docs: open this range on entry cloud firewall
# WG_UDP_PORT_MIN=51820
# WG_UDP_PORT_MAX=51830
WG_PANEL_DOMAIN=vpn.example.com
WG_PANEL_BRAND=My VPN
WG_PANEL_PORT=8088
WG_ADMIN_PORT=8090
WG_ADMIN_USER=admin
WG_ADMIN_PASS=change-me-min-8-chars
# WG_ADMIN_PASS_FILE=/root/admin.pass
# WG_ENABLE_SSL=yes
# WG_CERTBOT_EMAIL=admin@example.com

# --- Repair scripts (run on server) ---
# curl -fsSL .../fix-vpn-routing.sh -o /tmp/fix.sh && sudo bash /tmp/fix.sh --role entry|exit|auto
# curl -fsSL .../diagnose-vpn.sh -o /tmp/diag.sh && sudo bash /tmp/diag.sh --role entry|exit|auto

# --- Runtime: exit (/etc/wireguard/exit-server.env) ---
WG_ROLE=exit
WG_TUNNEL_IF=wg-tunnel
WG_TUNNEL_PUBLIC_IP=203.0.113.50
WG_CLIENT_CIDR=10.10.10.0/24
WG_TUNNEL_PEER_IP=10.200.0.2/32

# --- Runtime: entry (/etc/wireguard/entry-server.env) ---
WG_ROLE=entry
WG_DATA_DIR=/etc/wireguard
WG_IF=wg-clients
WG_TUNNEL_IF=wg-tunnel
WG_CLIENT_CIDR=10.10.10.0/24
WG_ENDPOINT=198.51.100.10:51820
WG_DEFAULT_ENDPOINT=198.51.100.10:51820
WG_EXIT_IP=203.0.113.50
WG_EXIT_TUNNEL_PORT=51821
WG_PANEL_PORT=8088
WG_ADMIN_PORT=8090
WG_PANEL_BRAND=My VPN
WG_HTTPS=1

# Client Endpoint file (devices use this):
# /etc/wireguard/wg-endpoint → 198.51.100.10:51820

# --- Per-client VPN mode (client-state/*.meta) ---
# VPN_MODE=twohop   # default / production — egress via exit VPS (table 100 → wg-tunnel)
# VPN_MODE=direct   # diagnostic only — egress via entry VPS NAT (entry IP visible)

# --- DNS for generated client configs ---
# Default: 8.8.8.8, 8.8.4.4
# WARNING: 1.1.1.1 and 8.8.8.8 are frequently blocked in Iran for UDP/53.
# Options that work better from Iran:
#   WG_DNS=EXIT_SERVER_IP          # If exit server runs a local resolver (recommended)
#   WG_DNS=8.8.4.4, 208.67.220.220 # Google secondary + OpenDNS secondary
#   WG_DNS=94.140.14.14, 94.140.15.15  # AdGuard (sometimes reachable)
# After changing: re-run wg-client renew <name> for existing clients, or
#                 update DNS= in /etc/wireguard/clients/*.conf manually.
# WG_DNS=8.8.8.8, 8.8.4.4

# --- Xray — alternative protocols that bypass deep packet inspection ---
# Set WG_XRAY_REALITY_SNI to enable Xray during entry-server install.
# VLESS+Reality makes traffic look like HTTPS to the SNI domain (e.g. www.microsoft.com).
WG_XRAY_REALITY_SNI=www.microsoft.com   # domain to impersonate (Reality TLS fingerprint)
# WG_XRAY_WS_DOMAIN=cdn.example.com     # Cloudflare-proxied domain for WebSocket fallback (optional)
# WG_SKIP_XRAY=1                         # set to 1 to skip Xray during entry-server install
# To install Xray after setup: sudo WG_XRAY_REALITY_SNI=www.microsoft.com bash deploy/install-xray.sh

# --- Performance tuning (entry + exit servers) ---
# WG_ENABLE_BBR=1              # TCP BBR when available + large socket *max* buffers (default on)
# WG_ENABLE_MSS_CLAMP=1        # persistent TCPMSS clamp via wg-mss-clamp.service
# WG_SERVER_MTU=1420           # default server WG MTU (1500 underlay − ~80 headroom)
# WG_CLIENTS_MTU=1420          # entry wg-clients MTU (defaults to WG_SERVER_MTU)
# WG_TUNNEL_MTU=1420           # wg-tunnel MTU on entry/exit (defaults to WG_SERVER_MTU)
# WG_CLIENT_MTU=1380           # fallback MTU in client .conf files
# WG_CLIENT_MTU_DIRECT=1420    # diagnostic direct-mode clients only
# WG_CLIENT_MTU_TWOHOP=1380    # production twohop clients (≈1500 − 2×60 WG overhead)
# WG_ENTRY_ANTILEAK=1          # DROP client→WAN on entry unless direct-mode ACCEPT
# Tune existing servers: sudo bash deploy/tune-vpn-performance.sh
# Migrate dataplane:     sudo bash deploy/migrate-vpn-stack.sh --role entry|exit
# Validate:              sudo bash deploy/validate-config.sh --role runtime
# Measure hops:          sudo bash deploy/measure-vpn-bandwidth.sh --role guide

# --- Ops: change servers (entry server) ---
# sudo bash deploy/change-entry-server.sh NEW_IP:51820
# sudo WG_EXIT_PUBLIC_IP=... WG_EXIT_TUNNEL_PUB=... bash deploy/change-exit-server.sh

# --- Panel: multiple configs per user (panel.db user_configs table) ---
# Client download: GET /configs.zip (all assigned configs)

# Certbot renew (cron): certbot renew --quiet && systemctl reload nginx
