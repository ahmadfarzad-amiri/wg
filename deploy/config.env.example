# Example configuration — copy and edit, or answer prompts during install.
# Exit server (/etc/wireguard/exit-server.env)
WG_PUBLIC_ENDPOINT=203.0.113.10:51820
WG_IF=wg-ir

# Panel server (/etc/wireguard/panel-server.env)
WG_DATA_DIR=/etc/wireguard
WG_BIN_DIR=/usr/local/bin
WG_EXIT_SSH=root@203.0.113.10
WG_EXIT_SSH_KEY=/root/.ssh/wg_exit
WG_ENDPOINT=203.0.113.10:51820
WG_PANEL_HOST=0.0.0.0
WG_PANEL_PORT=8088
WG_ADMIN_HOST=127.0.0.1
WG_ADMIN_PORT=8090
WG_ADMIN_BASE=/admin
WG_PANEL_BRAND=My VPN
WG_ADMIN_BRAND=My VPN

# Public domain (DNS must point to your proxy or panel server)
PANEL_DOMAIN=vpn.example.com
