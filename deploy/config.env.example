# Example configuration — install-time and runtime env vars

# --- Install: exit server ---
WG_EXIT_PUBLIC_IP=203.0.113.50
WG_TUNNEL_PORT=51821
WG_CLIENT_CIDR=10.10.10.0/24
# WG_ENTRY_PUBLIC_IP=198.51.100.10   # restrict exit tunnel UDP to entry IP
# WG_ENTRY_TUNNEL_PUB=...            # optional: add entry peer during exit install
# WG_INSTALL_MODE=upgrade|fresh
# WG_INSTALL_FORCE=1                 # overwrite without upgrade mode
# WG_UFW_ENABLE=1
# WG_INSTALL_INTERACTIVE=1           # prompt on TTY

# --- Install: entry server ---
WG_ENTRY_PUBLIC_IP=198.51.100.10
WG_EXIT_PUBLIC_IP=203.0.113.50
WG_EXIT_TUNNEL_PORT=51821
WG_EXIT_TUNNEL_PUB=base64ExitTunnelPubKey=
WG_CLIENT_PORT=51820
WG_PANEL_DOMAIN=vpn.example.com
WG_PANEL_BRAND=My VPN
WG_PANEL_PORT=8088
WG_ADMIN_PORT=8090
WG_ADMIN_USER=admin
WG_ADMIN_PASS=change-me-min-8-chars
# WG_ADMIN_PASS_FILE=/root/admin.pass
# WG_ENABLE_SSL=yes
# WG_CERTBOT_EMAIL=admin@example.com

# --- Runtime: exit (/etc/wireguard/exit-server.env) ---
WG_ROLE=exit
WG_TUNNEL_IF=wg-tunnel
WG_TUNNEL_PUBLIC_IP=203.0.113.50

# --- Runtime: entry (/etc/wireguard/entry-server.env) ---
WG_ROLE=entry
WG_DATA_DIR=/etc/wireguard
WG_IF=wg-clients
WG_ENDPOINT=198.51.100.10:51820
WG_DEFAULT_ENDPOINT=198.51.100.10:51820
WG_EXIT_IP=203.0.113.50
WG_EXIT_TUNNEL_PORT=51821
WG_PANEL_PORT=8088
WG_ADMIN_PORT=8090
WG_PANEL_BRAND=My VPN
WG_HTTPS=1

# Client Endpoint file (devices use this):
# /etc/wireguard/wg-endpoint → 198.51.100.10:51820

# Certbot renew (cron): certbot renew --quiet && systemctl reload nginx
