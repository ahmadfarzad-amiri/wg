#!/usr/bin/env python3
import os, sys, shlex, subprocess, time

WG_IF = "wg-clients"
WG_CONF = "/etc/wireguard/wg-clients.conf"
STATE_DIR = "/etc/wireguard/client-state"
CLIENT_DIR = "/etc/wireguard/clients"
SERVER_PUBLIC_KEY_FILE = "/etc/wireguard/clients-server.pub"


def read_default_endpoint():
    path = "/etc/wireguard/wg-endpoint"
    if os.path.isfile(path):
        with open(path, "r", encoding="utf-8", errors="ignore") as handle:
            value = handle.read().strip()
            if value:
                return value
    return os.environ.get("WG_DEFAULT_ENDPOINT", "127.0.0.1:51820")


DEFAULT_ENDPOINT = read_default_endpoint()

def die(msg):
    print(f"ERROR: {msg}", file=sys.stderr)
    sys.exit(1)

def run(cmd, input_text=None, check=True):
    p = subprocess.run(cmd, input=input_text, text=True, capture_output=True)
    if check and p.returncode != 0:
        die(p.stderr.strip() or p.stdout.strip() or f"Command failed: {' '.join(cmd)}")
    return p.stdout.strip()

def parse_meta(path):
    data = {}
    with open(path, "r", encoding="utf-8", errors="ignore") as f:
        for line in f:
            line = line.strip()
            if not line or "=" not in line:
                continue
            k, v = line.split("=", 1)
            try:
                parts = shlex.split(v)
                data[k] = parts[0] if parts else ""
            except Exception:
                data[k] = v.strip().strip("'\"")
    return data

def write_meta(path, data):
    with open(path, "w", encoding="utf-8") as f:
        for k in [
            "NAME","IP","PUBLIC_KEY","LIMIT_BYTES","EXPIRES_AT","CREATED_AT",
            "USED_BYTES","LAST_TOTAL","SINGLE_MODE","LOCKED_ENDPOINT",
            "LOCKED_IP","DISABLED","DISABLED_REASON","UPDATED_AT"
        ]:
            v = str(data.get(k, ""))
            f.write(f"{k}={shlex.quote(v)}\n")
    os.chmod(path, 0o600)

def remove_block(conf, name):
    if not os.path.exists(conf):
        die(f"{conf} not found")
    out = []
    skip = False
    with open(conf, "r", encoding="utf-8", errors="ignore") as f:
        for line in f:
            s = line.rstrip("\n")
            if s == f"# BEGIN CLIENT {name}":
                skip = True
                continue
            if s == f"# END CLIENT {name}":
                skip = False
                continue
            if not skip:
                out.append(line)
    with open(conf, "w", encoding="utf-8") as f:
        f.writelines(out)
    os.chmod(conf, 0o600)

def append_peer(conf, name, pub, ip):
    with open(conf, "a", encoding="utf-8") as f:
        f.write(f"\n# BEGIN CLIENT {name}\n")
        f.write("[Peer]\n")
        f.write(f"PublicKey = {pub}\n")
        f.write(f"AllowedIPs = {ip}/32\n")
        f.write(f"# END CLIENT {name}\n")
    os.chmod(conf, 0o600)

def get_endpoint_from_old_config(name):
    path = os.path.join(CLIENT_DIR, f"{name}.conf")
    if not os.path.exists(path):
        return DEFAULT_ENDPOINT
    with open(path, "r", encoding="utf-8", errors="ignore") as f:
        for line in f:
            if line.strip().startswith("Endpoint"):
                return line.split("=", 1)[1].strip()
    return DEFAULT_ENDPOINT

def main():
    if os.geteuid() != 0:
        die("Run as root")

    if len(sys.argv) < 2:
        die("Usage: wg-client-rotate-keys CLIENT_NAME")

    name = sys.argv[1]
    meta_path = os.path.join(STATE_DIR, f"{name}.meta")

    if not os.path.exists(meta_path):
        die(f"Client state not found: {meta_path}")

    data = parse_meta(meta_path)

    ip = data.get("IP")
    old_pub = data.get("PUBLIC_KEY")
    if not ip or not old_pub:
        die("Client metadata missing IP or PUBLIC_KEY")

    endpoint = get_endpoint_from_old_config(name)

    private_key = run(["wg", "genkey"])
    public_key = run(["wg", "pubkey"], input_text=private_key + "\n")

    server_pub = open(SERVER_PUBLIC_KEY_FILE).read().strip()

    os.makedirs(CLIENT_DIR, exist_ok=True)
    os.chmod(CLIENT_DIR, 0o700)

    # Remove old live peer.
    run(["wg", "set", WG_IF, "peer", old_pub, "remove"], check=False)

    # Update server config.
    backup = f"{WG_CONF}.bak.rotate.{int(time.time())}"
    subprocess.run(["cp", WG_CONF, backup], check=False)

    remove_block(WG_CONF, name)
    append_peer(WG_CONF, name, public_key, ip)

    # Add new live peer.
    run(["wg", "set", WG_IF, "peer", public_key, "allowed-ips", f"{ip}/32"], check=False)

    # Preserve MTU from existing config when rotating keys.
    client_conf = os.path.join(CLIENT_DIR, f"{name}.conf")
    mtu = "1380"
    if os.path.isfile(client_conf):
        with open(client_conf, encoding="utf-8", errors="ignore") as old:
            for line in old:
                if line.strip().startswith("MTU"):
                    mtu = line.split("=", 1)[1].strip()
                    break

    # Write new client config.
    with open(client_conf, "w", encoding="utf-8") as f:
        f.write("[Interface]\n")
        f.write(f"PrivateKey = {private_key}\n")
        f.write(f"Address = {ip}/32\n")
        f.write("DNS = 1.1.1.1, 8.8.8.8\n")
        f.write(f"MTU = {mtu}\n\n")
        f.write("[Peer]\n")
        f.write(f"PublicKey = {server_pub}\n")
        f.write(f"Endpoint = {endpoint}\n")
        f.write("AllowedIPs = 0.0.0.0/0\n")
        f.write("PersistentKeepalive = 25\n")
    os.chmod(client_conf, 0o600)

    # Preserve usage/expiry/limit and admin disable state.
    data["PUBLIC_KEY"] = public_key
    data["LAST_TOTAL"] = "0"
    data["LOCKED_ENDPOINT"] = ""
    data["LOCKED_IP"] = ""
    data["UPDATED_AT"] = str(int(time.time()))
    write_meta(meta_path, data)

    print(f"Rotated keys for: {name}")
    print(f"Config: {client_conf}")

if __name__ == "__main__":
    main()