class Handler(BaseHTTPRequestHandler):
    def clean_path(self):
        path = self.path.split("?",1)[0]
        return path.rstrip("/") or "/"

    def send_html(self, content, code=200):
        raw = content.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type","text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)

    def redirect(self, path):
        self.send_response(302)
        self.send_header("Location", BASE + path)
        self.end_headers()

    def post_data(self):
        length = int(self.headers.get("Content-Length","0") or 0)
        raw = self.rfile.read(length).decode("utf-8", errors="ignore")
        return {k:v[0] for k,v in urllib.parse.parse_qs(raw).items()}

    def is_logged_in(self):
        cookie = SimpleCookie(self.headers.get("Cookie",""))
        token = cookie.get("admin_session")
        if not token:
            return False
        con = session_db()
        row = con.execute("SELECT token FROM sessions WHERE token=? AND expires_at>?", (token.value, int(time.time()))).fetchone()
        con.close()
        return bool(row)

    def require_login(self):
        if not self.is_logged_in():
            self.redirect("/login")
            return False
        return True

    def do_GET(self):
        path = self.clean_path()

        if path == "/login":
            self.send_html(login_page())
            return

        if not self.require_login():
            return

        if path == "/":
            self.dashboard()
        elif path == "/clients":
            self.clients()
        elif path == "/users":
            self.users()
        elif path == "/requests":
            self.requests()
        elif path == "/active":
            self.active()
        elif path == "/tools":
            self.tools()
        elif path == "/settings":
            self.settings()
        elif path.startswith("/config/"):
            self.download_config(path.split("/config/",1)[1])
        else:
            self.send_html(page("Not found", "<h1>Not found</h1>"), 404)

    def do_POST(self):
        path = self.clean_path()

        if path == "/login":
            data = self.post_data()
            if verify_admin(data.get("username",""), data.get("password","")):
                token = secrets.token_urlsafe(32)
                con = session_db()
                con.execute("INSERT INTO sessions(token,expires_at) VALUES(?,?)", (token, int(time.time()) + 86400))
                con.commit()
                con.close()
                self.send_response(302)
                self.send_header("Location", BASE + "/")
                self.send_header("Set-Cookie", f"admin_session={token}; HttpOnly; SameSite=Strict; Path={BASE}; Max-Age=86400")
                self.end_headers()
            else:
                self.send_html(login_page("Invalid username or password"), 403)
            return

        if not self.require_login():
            return

        if path == "/logout":
            cookie = SimpleCookie(self.headers.get("Cookie",""))
            token = cookie.get("admin_session")
            if token:
                con = session_db()
                con.execute("DELETE FROM sessions WHERE token=?", (token.value,))
                con.commit()
                con.close()
            self.send_response(302)
            self.send_header("Location", BASE + "/login")
            self.send_header("Set-Cookie", f"admin_session=deleted; HttpOnly; SameSite=Strict; Path={BASE}; Max-Age=0")
            self.end_headers()
            return

        data = self.post_data()
        action = data.get("action","")

        if path == "/client-action":
            self.client_action(action, data)
        elif path == "/user-action":
            self.user_action(action, data)
        elif path == "/request-action":
            self.request_action(action, data)
        elif path == "/tool-action":
            self.tool_action(action, data)
        elif path == "/active-action":
            self.active_action(action, data)
        else:
            self.send_html(page("Not found", "<h1>Not found</h1>"), 404)

