    def download_config(self, client):
        client = safe_name(client)
        path = os.path.join(CLIENT_DIR, f"{client}.conf")
        if not os.path.exists(path):
            self.send_html(page("Not found", "<h1>Config not found</h1>"), 404)
            return
        raw = open(path, "rb").read()
        self.send_response(200)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Disposition", f'attachment; filename="{client}.conf"')
        self.send_header("Content-Length", str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)

    def client_action(self, action, data):
        client = safe_name(data.get("client",""))

        if not client:
            self.clients("Client name required")
            return

        meta = None
        c = None
        for m in all_client_meta():
            if m.get("NAME") == client:
                meta = m
                c = client_status(m)
                break

        if action == "add":
            days = data.get("days","30")
            limit = data.get("limit","20G")
            single = data.get("single","--single-ip")
            out = run(["wg-client","add",client,"--days",days,"--limit",limit,single])

        elif action == "set-single":
            mode = data.get("single_mode", "ip")
            if mode not in ["off", "ip", "endpoint"]:
                self.clients("Invalid single mode")
                return
            out = run(["wg-client-single", client, mode])

        elif action == "enable":
            if not c:
                self.clients("Client not found")
                return
            if not c["disabled"]:
                self.clients("This client is already enabled.")
                return
            out = run(["wg-client","enable",client])

        elif action == "disable":
            if not c:
                self.clients("Client not found")
                return
            if c["disabled"]:
                self.clients("This client is already disabled.")
                return
            out = run(["wg-client","disable",client,"disabled from admin panel"])

        elif action == "renew":
            if not c:
                self.clients("Client not found")
                return
            if not (c.get("expired") or c.get("over_limit")):
                self.clients("Renew is available only when the client is expired or data limit is finished.")
                return
            out = run(["wg-client","renew",client,"--days","30","--limit","20G","--single-ip"])

        elif action == "remove":
            if not c:
                self.clients("Client not found")
                return
            out = run(["wg-client","remove",client])

        else:
            out = "Unknown action"

        self.clients(out[-1000:])

    def user_action(self, action, data):
        username = safe_name(data.get("username",""))
        client = safe_name(data.get("client",""))

        if not username:
            self.users("Username required")
            return

        try:
            con = panel_db()
            row = con.execute("SELECT status, COALESCE(client_name,'') AS client_name FROM users WHERE username=?", (username,)).fetchone()
            con.close()
        except Exception:
            row = None

        if not row:
            self.users("User not found")
            return

        status = row["status"]
        assigned_client = row["client_name"]

        if action == "approve":
            if status == "approved" and assigned_client:
                self.users("User is already approved and assigned.")
                return
            if not client:
                self.users("Client name is required for approval.")
                return
            out = run(["wg-panel-admin","approve",username,client])

        elif action == "reject":
            if status != "pending":
                self.users("Only pending users can be rejected.")
                return
            out = run(["wg-panel-admin","reject",username])

        elif action == "disable":
            if status != "approved":
                self.users("Only approved users can be disabled.")
                return
            out = run(["wg-panel-admin","disable-user",username])

        elif action == "enable":
            if status != "disabled":
                self.users("Only disabled users can be enabled.")
                return
            out = run(["wg-panel-admin","enable-user",username])

        else:
            out = "Unknown action"

        self.users(out[-1000:])

    def request_action(self, action, data):
        rid = data.get("id","")

        if not rid.isdigit():
            self.requests("Invalid request id")
            return

        try:
            con = panel_db()
            row = con.execute("SELECT status FROM requests WHERE id=?", (rid,)).fetchone()
            con.close()
        except Exception:
            row = None

        if not row:
            self.requests("Request not found")
            return

        if row["status"] != "pending":
            self.requests("This request is already processed.")
            return

        if action == "approve":
            out = run(["wg-panel-admin","approve-request",rid,"--days","30","--limit","20G","--single-ip"])
        elif action == "reject":
            out = run(["wg-panel-admin","reject-request",rid])
        else:
            out = "Unknown action"

        self.requests(out[-1000:])

